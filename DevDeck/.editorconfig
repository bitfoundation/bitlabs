root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{toml,json,yml,yaml,manifest,xml}]
indent_size = 2

# cmd.exe needs CRLF line endings in batch files.
[*.{bat,cmd}]
end_of_line = crlf

# Generated by cargo.
[Cargo.lock]
indent_style = unset
indent_size = unset
